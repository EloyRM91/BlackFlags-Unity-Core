  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14e62f9bdba90804792ea654fe69c94d, type: 3}
  m_Name: CAT_FileWarnings
  m_EditorClassIdentifier: 
  entries:
  - key: oldVersion
    warn: "La partida fue creada en una versi\xF3n distinta"
    details: "Est\xE1s intentando cargar una partida que fue guardada en una versi\xF3n
      diferente del juego. Cargar una partida de una versi\xF3n deprecada puede causar
